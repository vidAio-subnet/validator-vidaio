# VidAIO public configuration template (miner + third-party validator surfaces)
#
# Placeholders only; contains no secrets. Copy into your secret-management/deployment
# system, replace every REPLACE_* value, and run scripts/production_preflight.py inside
# the exact release image. Do not source this file unchanged. This is a superset of the
# public roles: generate a least-privilege per-role environment from it (miner, thin
# validator, auditor) rather than giving every process every credential.
# Nested VIDAIO settings are YAML-parsed.

# --- Bittensor network + schema-v16 fleet fence ------------------------------------
VIDAIO__CHAIN__MODE=bittensor
VIDAIO__CHAIN__NETWORK=finney                # or 'test' first (see the README)
VIDAIO__CHAIN__NETUID=85
VIDAIO__CORE__NETUID=85
VIDAIO__WEIGHTSETTER__AUTHORITY_NETUID=85
# Independent auditors archive-read challenge anchors under this same subnet id.
VIDAIO__AUDITOR__CHALLENGE_ANCHOR_NETUID=85
# Use an archive-capable endpoint. Retention on public endpoints is not a
# guarantee — live preflight must prove the actual chosen endpoint. Keep
# failover empty until a second endpoint passes the same proof.
VIDAIO__CHAIN__ENDPOINT=wss://REPLACE_ARCHIVE_CHAIN_ENDPOINT:443
VIDAIO__CHAIN__FALLBACK_ENDPOINTS=[]
VIDAIO__CHAIN__VALIDATOR_HOTKEY=REPLACE_YOUR_SS58
# A thin-validator role sets chain.validator_hotkey to its own wallet and
# anchor_hotkey to the authority's anchor signer (which may be distinct). A miner
# sets chain.validator_hotkey equal to miner.artifact_hotkey and needs no anchor
# credentials.
VIDAIO__CHAIN__ANCHOR_HOTKEY=REPLACE_AUTHORITY_ANCHOR_SS58
VIDAIO__CHAIN__ANCHOR_WRITER_LOCK_PATH=/var/lib/vidaio/state/anchor-writer.lock
VIDAIO__CHAIN__ANCHOR_WRITER_LOCK_TIMEOUT_SECONDS=30
VIDAIO__CHAIN__VERSION_KEY=16
VIDAIO__WEIGHTSETTER__VERSION_KEY=16
VIDAIO__WEIGHTSETTER__VALIDATOR_HOTKEY=REPLACE_YOUR_SS58
VIDAIO__WEIGHTSETTER__PROVIDER=shared
VIDAIO__WEIGHTSETTER__VERIFY_ANCHOR=true
VIDAIO__WEIGHTSETTER__CHAIN_TIMEOUT_SECONDS=180
# Optionally point this at another validator's registered hotkey. Peer reads
# populate the diagnostic convergence gauge and never gate submissions.
VIDAIO__WEIGHTSETTER__CONVERGENCE_OBSERVE_ENABLED=true
VIDAIO__WEIGHTSETTER__CONVERGENCE_PEER_HOTKEYS='["REPLACE_OTHER_VALIDATOR_SS58"]'

# Durable one-host state layout. Give each host a coherent local filesystem/volume;
# never share SQLite WAL files over NFS/object storage or incoherent cross-container mounts.
VIDAIO__CORE__DATA_DIR=/var/lib/vidaio/state
VIDAIO__CORE__DB_FILENAME=vidaio.db
VIDAIO__LOCAL_STACK__AUDITOR_CURSOR_DB_PATH=/var/lib/vidaio/beacon-auditor-state/auditor-cursor.db
VIDAIO__LOCAL_STACK__OWN_AUDITOR_CURSOR_DB_PATH=/var/lib/vidaio/own-auditor-state/own-auditor-cursor.db

# Before first launch, set the audit floor to a FUTURE runtime SubnetEpochIndex
# (normally the latest archive-proven closed index + 1 — preflight prints the exact
# value to configure). Every process must use the same positive integer; do not
# infer it from an authority-controlled 404.
VIDAIO__LOCAL_STACK__AUDITOR_CURSOR_FLOOR=REPLACE_FUTURE_RUNTIME_EPOCH_INDEX
VIDAIO__LOCAL_STACK__AUDITOR_BEACON_CONFIRMATION_DEPTH=20
# Turn repeated auditor dependency failures into a fatal supervised exit.
VIDAIO__LOCAL_STACK__AUDITOR_MAX_CONSECUTIVE_FAILURES=5
VIDAIO__LOCAL_STACK__OWN_AUDITOR_MAX_CONSECUTIVE_FAILURES=5
# A repeated HOLD/REFUSE on the same required epoch exits fatally at this many
# passes (30 is about 10 minutes at the production 20-second audit cadence).
VIDAIO__LOCAL_STACK__AUDITOR_MAX_CONSECUTIVE_STALLS=30
VIDAIO__LOCAL_STACK__OWN_AUDITOR_MAX_CONSECUTIVE_STALLS=30
# Stable HealthServer endpoints for the two script-owned auditor loops. Production
# guards require these exact, distinct ports.
VIDAIO__LOCAL_STACK__AUDITOR_METRICS_PORT=9121
VIDAIO__LOCAL_STACK__OWN_AUDITOR_METRICS_PORT=9122

# Choose an on-disk btcli hotkey OR the seed variable below. Never deploy a coldkey.
# Each role gets its own wallet: a validator's wallet is its registered validator
# hotkey; a miner's wallet equals miner.artifact_hotkey.
VIDAIO__CHAIN__WALLET_NAME=
VIDAIO__CHAIN__WALLET_HOTKEY=
VIDAIO__CHAIN__WALLET_PATH=
VIDAIO__CHAIN__HOTKEY_SEED_ENV=VIDAIO_HOTKEY_SEED
VIDAIO_HOTKEY_SEED=REPLACE_WITH_HOTKEY_SEED_OR_MNEMONIC

# Production derives this from chain; configured fallback UIDs must remain null.
VIDAIO__WEIGHTSETTER__BURN_UID=null

# --- Authority pointer + audit-results access (validator/auditor roles) -------------
# Client-side read access to the authority pointer API and the audit-results API.
# Validator-facing endpoints authenticate registered hotkeys (see the README);
# these bearer fields carry any additionally issued read/report tokens.
VIDAIO_AUTHORITY_READ_TOKEN=REPLACE_WITH_AUTHORITY_READ_TOKEN
VIDAIO__WEIGHTSETTER__AUTHORITY_URL=https://REPLACE_AUTHORITY_HOST
VIDAIO__WEIGHTSETTER__AUTHORITY_TOKEN=REPLACE_WITH_SAME_AUTHORITY_READ_TOKEN
VIDAIO__LOCAL_STACK__AUTHORITY_URL=https://REPLACE_AUTHORITY_HOST
VIDAIO_AUDIT_RESULTS_TOKEN=REPLACE_WITH_AUDIT_REPORT_TOKEN
VIDAIO__AUDIT_API__DEV_INSECURE_VERIFIER=false
VIDAIO__LOCAL_STACK__AUDIT_API_URL=https://REPLACE_AUDIT_RESULTS_HOST

# Permissionless network: there is no shared miner token. Artifact protocol v2
# authenticates registered validator requests and miner responses by hotkey. Leave
# these optional extra bearer fields unset; a controlled fleet may set both to the
# same private defense-in-depth secret. Keep a hardened TLS/rate/connection-limiting
# edge in front of the miner.
VIDAIO__MINER__API_TOKEN=null
VIDAIO__VALIDATOR__MINER_API_TOKEN=""
# Deprecated JSON absolute-path routes are local-test-only and production-forbidden.
VIDAIO__MINER__ENABLE_LEGACY_PATH_ROUTES=false

# --- Scorer identity + CPU-only recomputation ---------------------------------------
# The worker mints <base>+<config-and-runtime-digest12>. Read the full value from
# GET /healthz only after pinning the exact release image and scoring settings,
# then replace the full-identity placeholder.
VIDAIO__SCORING_WORKER__SCORER_VERSION=vidaio-scorer/1
VIDAIO__SCORING_WORKER__PIEAPP_DEVICE=cpu
VIDAIO__SCORING_WORKER__PERCEPTUAL_CHECKS=required
VIDAIO__VALIDATOR__SCORER_VERSION=REPLACE_WITH_EFFECTIVE_SCORER_IDENTITY
# Auditors independently recompute every committed media item. The production
# guard requires exactly 1.0 and the runtime uses uncapped all-items mode.
VIDAIO__LOCAL_STACK__AUDITOR_MEDIA_SAMPLE_RATE=1.0
VIDAIO__LOCAL_STACK__OWN_AUDITOR_MEDIA_SAMPLE_RATE=1.0

# --- S3-compatible evidence store ----------------------------------------------------
# Copy the locator fields to every role, then split the credentials by role in the
# real secret manager:
# - thin-validator-node: scoped public-evidence + weight_vector/manifest writer IAM,
#   no AES key, with canonical reference_original/ explicitly denied;
# - beacon/own audit workers: public READ credentials only and no AES key; each gets
#   its own signing wallet, report token, state directory, and cursor DB;
# - miners: no evidence-store credentials at all.
VIDAIO__AUDIT__BACKEND=s3
VIDAIO__AUDIT__S3_BUCKET=REPLACE_AUDIT_BUCKET
VIDAIO__AUDIT__S3_REGION=REPLACE_REGION
VIDAIO__AUDIT__S3_PREFIX=REPLACE_DEPLOYMENT_PREFIX
VIDAIO__AUDIT__S3_ENDPOINT_URL_ENV=VIDAIO_S3_ENDPOINT
VIDAIO__AUDIT__S3_ACCESS_KEY_ENV=VIDAIO_S3_ACCESS_KEY_ID
VIDAIO__AUDIT__S3_SECRET_KEY_ENV=VIDAIO_S3_SECRET_ACCESS_KEY
VIDAIO__AUDIT__HOLDOUT_KEY_ENV=VIDAIO_AUDIT_HOLDOUT_KEY
VIDAIO__AUDIT__ALLOW_PLAINTEXT_HOLDOUT=false
VIDAIO__AUDIT__RETENTION_DAYS=0
VIDAIO_S3_ENDPOINT=https://REPLACE_S3_COMPATIBLE_ENDPOINT
VIDAIO_S3_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY
VIDAIO_S3_SECRET_ACCESS_KEY=REPLACE_S3_SECRET_KEY

# Bucket-policy contract (not an env setting): public GetObject is limited to
# challenge_input/, miner_output/, manifest/, score_packet/, weight_vector/,
# dag_reveal/, epoch_log/, audit_bundle/, finalized/,
# released/reference_original/, and released/submission_archive/. Canonical
# reference_original/ and submission_archive/ stay private.

# --- Path-free remote miner artifacts + hard caps -----------------------------------
# The validator owns this landing zone; miners only receive/return bounded HTTP bytes.
VIDAIO__VALIDATOR__MINER_ARTIFACT_DIR=/var/lib/vidaio/validator-miner-artifacts
VIDAIO__VALIDATOR__MINER_MAX_INPUT_BYTES=2147483648
VIDAIO__VALIDATOR__MINER_MAX_OUTPUT_BYTES=4294967296
VIDAIO__MINER__WORK_DIR=/var/lib/vidaio/miner
VIDAIO__MINER__MAX_INPUT_BYTES=2147483648
VIDAIO__MINER__MAX_OUTPUT_BYTES=4294967296
# The reference miner runs ffmpeg in-process. A custom GPU backend can instead set
# backend_mode=remote_gpu with its own HTTPS ingress; generate a distinct role env
# per hotkey and never copy one token/URL/identity across ingresses unchanged.
VIDAIO__MINER__BACKEND_MODE=ffmpeg
# VIDAIO__MINER__REMOTE_GPU_URL=https://REPLACE_YOUR_GPU_BACKEND_URL
# VIDAIO__MINER__REMOTE_GPU_AUTH_TOKEN=REPLACE_WITH_FRESH_PROFILE_BEARER
# VIDAIO__MINER__REMOTE_GPU_SOLUTION_VARIANT=REPLACE_quality_OR_balanced_OR_compact
# VIDAIO__MINER__REMOTE_GPU_CONNECT_TIMEOUT_SECONDS=10
VIDAIO__MINER__WARRANT_TRACK=REPLACE_compression_OR_upscaling
VIDAIO__MINER__ARTIFACT_INGRESS_TIMEOUT_SECONDS=60
VIDAIO__MINER__ARTIFACT_HOTKEY=REPLACE_MINER_SS58
VIDAIO__MINER__ALLOW_UNSIGNED_ARTIFACT_V1=false
VIDAIO__MINER__ARTIFACT_REQUEST_MAX_AGE_SECONDS=120
VIDAIO__MINER__ARTIFACT_REQUEST_FUTURE_SKEW_SECONDS=5
VIDAIO__MINER__ARTIFACT_REPLAY_CACHE_ENTRIES=10000
VIDAIO__MINER__ARTIFACT_REPLAY_CACHE_ENTRIES_PER_VALIDATOR=256
VIDAIO__MINER__ARTIFACT_VALIDATOR_SNAPSHOT_MAX_AGE_SECONDS=300
# On every restart, requests at/before start + FUTURE_SKEW receive 425 until callers
# retry with a fresh timestamp/nonce; this fences the reset in-memory replay cache.
# Replay state is process-local: one ARTIFACT_HOTKEY must terminate at one ingress
# process/endpoint. Do not load-balance replicas that share a hotkey.
VIDAIO__MINER__RETAIN_TASK_DIRS=false

# SSRF/public-address policy: production dials only globally routable literal axon IPs.
# Keep false.
VIDAIO__VALIDATOR__ALLOW_NON_PUBLIC_MINER_ADDRESSES=false
VIDAIO__VALIDATOR__MINER_PORT=8300
# Axon records contain only IP/port. Set one fleet-wide scheme and pass the same
# scheme in advertise/live-preflight URLs. HTTPS requires an IP-valid public cert.
VIDAIO__VALIDATOR__MINER_URL_SCHEME=https

# --- CI-gated code autoupdater ------------------------------------------------------
# Safe shipped posture: report a version change but execute nothing. This role needs no
# wallet/S3 secrets while UPDATE_COMMAND is empty.
VIDAIO__AUTOUPDATER__VERSION_SOURCE=file
VIDAIO__AUTOUPDATER__VERSION_FILE=/app/VERSION
VIDAIO__AUTOUPDATER__VERSION_URL=""
VIDAIO__AUTOUPDATER__UPDATE_COMMAND='[]'
VIDAIO__AUTOUPDATER__REQUIRE_CI_PASS=true
VIDAIO__AUTOUPDATER__ALLOW_DOWNGRADE=false
VIDAIO__AUTOUPDATER__SOURCE_ROOT=/srv/vidaio/staged-release
VIDAIO__AUTOUPDATER__CI_PASS_MARKER=data/ci-pass
VIDAIO__AUTOUPDATER__RUNTIME_MANIFEST_FILE=runtime-release-manifest.json
VIDAIO__AUTOUPDATER__STATE_FILE=/var/lib/vidaio/autoupdater-state.json
# To arm only after atomically staging the exact full-CI target tree + marker/manifest:
# VIDAIO__AUTOUPDATER__VERSION_SOURCE=http
# VIDAIO__AUTOUPDATER__VERSION_URL=https://REPLACE_RELEASE_VERSION_HOST/VERSION
# VIDAIO__AUTOUPDATER__UPDATE_COMMAND='["/usr/local/bin/REPLACE_ACTIVATOR"]'
# The activator switches to VIDAIO_AUTOUPDATER_STAGED_ROOT and receives verified target
# VERSION, source sha256, and runtime sha256 environment variables. Do not put credentials
# in VERSION_URL; see vidaio/autoupdater/README.md.
